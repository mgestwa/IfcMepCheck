# Settings for `mepcheck explain`. Copy to .env (git-ignored) or export them in your shell;
# variables already set in the environment win over .env.

# anthropic (default) or openai
MEPCHECK_LLM_PROVIDER=anthropic

# Model name. Default for anthropic: claude-opus-5-5. Required for openai.
MEPCHECK_LLM_MODEL=

# API key of the selected provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where LLM answers are cached (default: .mepcheck_cache)
# MEPCHECK_CACHE_DIR=.mepcheck_cache
